<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Panel — MediCore</title>
  <%- include('../partials/styles') %>
</head>
<body>
<div class="app-shell">

  <% const currentRole = 'admin'; const currentUser = 'Admin'; const activeLink = 'Dashboard'; %>
  <%- include('../partials/sidebar') %>

  <main class="main-content">

    <!-- Page Header -->
    <div class="page-header-row page-header">
      <div>
        <h1>User Management</h1>
        <p>Manage hospital staff and patient accounts</p>
      </div>
      <button class="btn btn-primary" id="open-modal-btn">
        ⊕ &nbsp;Add New User
      </button>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
      <%
        const roles = ['admin','doctor','nurse','receptionist','pharmacy','petant'];
        const roleColors = {
          admin:'#3d8bff', doctor:'#2dca73', nurse:'#f5a623',
          receptionist:'#a78bfa', pharmacy:'#ff4d6d', petant:'#6b7280'
        };
        const totalUsers = users.length;
        const activeUsers = users.filter(u => u.isActive).length;
        const roleCounts = {};
        roles.forEach(r => { roleCounts[r] = users.filter(u => u.role === r).length; });
      %>
      <div class="stat-card" style="--accent-color:#3d8bff">
        <div class="stat-number"><%= totalUsers %></div>
        <div class="stat-label">Total Users</div>
      </div>
      <div class="stat-card" style="--accent-color:#2dca73">
        <div class="stat-number"><%= activeUsers %></div>
        <div class="stat-label">Active</div>
      </div>
      <div class="stat-card" style="--accent-color:#2dca73">
        <div class="stat-number"><%= roleCounts['doctor'] %></div>
        <div class="stat-label">Doctors</div>
      </div>
      <div class="stat-card" style="--accent-color:#f5a623">
        <div class="stat-number"><%= roleCounts['nurse'] %></div>
        <div class="stat-label">Nurses</div>
      </div>
      <div class="stat-card" style="--accent-color:#6b7280">
        <div class="stat-number"><%= roleCounts['petant'] %></div>
        <div class="stat-label">Patients</div>
      </div>
    </div>

    <!-- Users Table -->
    <div class="table-card">
      <div class="table-card-header">
        <span class="table-card-title">All Users</span>
        <input type="text" class="search-input" id="search-input" placeholder="🔍  Search by name or email…"/>
      </div>

      <% if (users.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon">◈</div>
          <p>No users found. Add your first user.</p>
        </div>
      <% } else { %>
      <div style="overflow-x:auto;">
        <table id="users-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Role</th>
              <th>Status</th>
              <th>Joined</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(user) { %>
            <tr data-search="<%= user.name.toLowerCase() %> <%= user.email.toLowerCase() %>">
              <td>
                <div class="user-cell">
                  <div class="user-table-avatar"><%= user.name[0].toUpperCase() %></div>
                  <div>
                    <div class="user-cell-name"><%= user.name %></div>
                    <div class="user-cell-email"><%= user.email %></div>
                  </div>
                </div>
              </td>
              <td>
                <form method="POST" action="/api/auth/admin/user/<%= user._id %>?_method=PATCH" class="role-form">
                  <select name="role" class="role-select" onchange="this.form.submit()">
                    <% ['admin','doctor','nurse','receptionist','pharmacy','petant'].forEach(function(r){ %>
                      <option value="<%= r %>" <%= user.role === r ? 'selected' : '' %>><%= r %></option>
                    <% }) %>
                  </select>
                </form>
              </td>
              <td>
                <span class="badge <%= user.isActive ? 'badge-active' : 'badge-inactive' %>">
                  <%= user.isActive ? '● Active' : '○ Inactive' %>
                </span>
              </td>
              <td style="color:var(--muted)">
                <%= new Date(user.createdAt).toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric'}) %>
              </td>
              <td>
                <div class="action-group">
                  <!-- Toggle Active -->
                  <form method="POST" action="/api/auth/user/<%= user._id %>?_method=PATCH" style="display:inline">
                    <input type="hidden" name="isActive" value="<%= user.isActive ? 'false' : 'true' %>"/>
                    <button type="submit" class="btn btn-ghost btn-sm" title="<%= user.isActive ? 'Deactivate' : 'Activate' %>">
                      <%= user.isActive ? '⊘' : '✓' %>
                    </button>
                  </form>
                  <!-- Permanent Delete -->
                  <button class="btn btn-danger btn-sm"
                    onclick="confirmDelete('<%= user._id %>', '<%= user.name %>')">
                    ✕
                  </button>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

  </main>
</div>

<!-- Add User Modal -->
<div class="modal-backdrop" id="modal-backdrop">
  <div class="modal">
    <button class="modal-close" id="close-modal">✕</button>
    <div class="modal-title">Add New User</div>
    <form method="POST" action="/api/auth/register" id="add-user-form">
      <div class="form-row">
        <div class="form-group">
          <label>Full Name</label>
          <input type="text" name="name" class="form-control" placeholder="John Doe" required/>
        </div>
        <div class="form-group">
          <label>Role</label>
          <select name="role" class="form-control">
            <option value="petant">Patient</option>
            <option value="doctor">Doctor</option>
            <option value="nurse">Nurse</option>
            <option value="receptionist">Receptionist</option>
            <option value="pharmacy">Pharmacy</option>
            <option value="admin">Admin</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Email Address</label>
        <input type="email" name="email" class="form-control" placeholder="user@hospital.com" required/>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" class="form-control" placeholder="Min. 6 characters" required minlength="6"/>
      </div>
      <div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1.5rem">
        <button type="button" class="btn btn-ghost" id="cancel-modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Create User →</button>
      </div>
    </form>
  </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal-backdrop" id="delete-backdrop">
  <div class="modal" style="max-width:380px;text-align:center">
    <div class="modal-title" style="color:var(--danger)">Delete User?</div>
    <p style="color:var(--muted);font-size:.875rem;margin-bottom:1.5rem">
      This will permanently remove <strong id="delete-name"></strong> from the system. This action cannot be undone.
    </p>
    <div style="display:flex;gap:.75rem;justify-content:center">
      <button class="btn btn-ghost" onclick="closeDeleteModal()">Cancel</button>
      <form method="POST" id="delete-form">
        <input type="hidden" name="_method" value="DELETE"/>
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
      </form>
    </div>
  </div>
</div>

<!-- Toast -->
<div class="toast" id="toast"></div>

<script>
  // Modal
  const backdrop  = document.getElementById('modal-backdrop');
  const openBtn   = document.getElementById('open-modal-btn');
  const closeBtn  = document.getElementById('close-modal');
  const cancelBtn = document.getElementById('cancel-modal');

  openBtn .addEventListener('click', () => backdrop.classList.add('open'));
  closeBtn.addEventListener('click', () => backdrop.classList.remove('open'));
  cancelBtn.addEventListener('click',() => backdrop.classList.remove('open'));
  backdrop.addEventListener('click', e => { if(e.target === backdrop) backdrop.classList.remove('open'); });

  // Delete confirm
  function confirmDelete(id, name) {
    document.getElementById('delete-name').textContent = name;
    document.getElementById('delete-form').action = '/api/auth/user/permanent/' + id;
    document.getElementById('delete-backdrop').classList.add('open');
  }
  function closeDeleteModal() {
    document.getElementById('delete-backdrop').classList.remove('open');
  }
  document.getElementById('delete-backdrop').addEventListener('click', function(e) {
    if(e.target === this) closeDeleteModal();
  });

  // Search
  document.getElementById('search-input').addEventListener('input', function() {
    const q = this.value.toLowerCase();
    document.querySelectorAll('#users-table tbody tr').forEach(row => {
      const s = row.dataset.search || '';
      row.style.display = s.includes(q) ? '' : 'none';
    });
  });

  // Toast helper
  function showToast(msg, type = 'success') {
    const t = document.getElementById('toast');
    t.textContent = (type === 'success' ? '✓ ' : '✕ ') + msg;
    t.className = 'toast toast--' + type + ' show';
    setTimeout(() => t.classList.remove('show'), 3500);
  }
</script>
</body>
</html>
