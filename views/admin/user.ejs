<!DOCTYPE html>
<html>
  <head>
    <title>Admin - Manage Users</title>
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --bg: #0f1117;
        --sidebar-bg: #161a24;
        --sidebar-border: #242836;
        --surface: #1c2030;
        --surface-hover: #222840;
        --accent: #c0392b;
        --accent-soft: rgba(192, 57, 43, 0.15);
        --text: #e8eaf0;
        --text-muted: #6b7280;
        --border: #242836;
        --warn: #7c3a1e;
        --warn-text: #f4a261;
        --danger: #c0392b;
        --update: #1a3a5c;
        --update-text: #64b5f6;
        --sidebar-w: 240px;
      }

      body {
        font-family: "IBM Plex Sans", sans-serif;
        background: var(--bg);
        color: var(--text);
        display: flex;
        min-height: 100vh;
      }

      /* ── SIDEBAR ── */
      .sidebar {
        width: var(--sidebar-w);
        background: var(--sidebar-bg);
        border-right: 1px solid var(--sidebar-border);
        display: flex;
        flex-direction: column;
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        z-index: 100;
      }

      .sidebar-logo {
        padding: 28px 24px 20px;
        border-bottom: 1px solid var(--sidebar-border);
      }

      .sidebar-logo .logo-mark {
        font-family: "IBM Plex Mono", monospace;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--accent);
      }

      .sidebar-logo .logo-name {
        font-size: 17px;
        font-weight: 600;
        color: var(--text);
        margin-top: 4px;
      }

      .sidebar-section {
        padding: 20px 12px 8px;
      }

      .sidebar-label {
        font-family: "IBM Plex Mono", monospace;
        font-size: 9px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--text-muted);
        padding: 0 12px 8px;
      }

      .nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        border-radius: 8px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 14px;
        font-weight: 400;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
        margin-bottom: 2px;
        border: none;
        background: none;
        width: 100%;
        text-align: left;
      }

      .nav-item:hover {
        background: var(--surface-hover);
        color: var(--text);
      }

      .nav-item.active {
        background: var(--accent-soft);
        color: var(--text);
        font-weight: 500;
      }

      .nav-item.active .nav-icon {
        color: var(--accent);
      }

      .nav-icon {
        font-size: 16px;
        width: 20px;
        text-align: center;
        flex-shrink: 0;
      }

      .sidebar-footer {
        margin-top: auto;
        padding: 16px 12px;
        border-top: 1px solid var(--sidebar-border);
      }

      .admin-badge {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        background: var(--surface);
        border-radius: 8px;
      }

      .avatar {
        width: 32px;
        height: 32px;
        background: var(--accent);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: "IBM Plex Mono", monospace;
        font-size: 12px;
        font-weight: 600;
        color: #fff;
        flex-shrink: 0;
      }

      .admin-info .admin-name {
        font-size: 13px;
        font-weight: 500;
        color: var(--text);
      }

      .admin-info .admin-role {
        font-size: 11px;
        color: var(--text-muted);
        font-family: "IBM Plex Mono", monospace;
      }

      /* ── MAIN CONTENT ── */
      .main {
        margin-left: var(--sidebar-w);
        flex: 1;
        display: flex;
        flex-direction: column;
      }

      .topbar {
        padding: 20px 32px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--bg);
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .page-title {
        font-size: 20px;
        font-weight: 600;
        color: var(--text);
      }

      .page-subtitle {
        font-size: 12px;
        color: var(--text-muted);
        font-family: "IBM Plex Mono", monospace;
        margin-top: 2px;
      }

      .topbar-actions {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .btn-add {
        background: var(--accent);
        color: #fff;
        border: none;
        padding: 8px 16px;
        border-radius: 7px;
        font-family: "IBM Plex Sans", sans-serif;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: opacity 0.15s;
      }

      .btn-add:hover {
        opacity: 0.85;
      }

      .content {
        padding: 28px 32px;
      }

      /* ── PAGE VIEWS ── */
      .page-view {
        display: none;
      }
      .page-view.active {
        display: block;
      }

      /* ── TABLE ── */
      .table-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      thead {
        background: var(--sidebar-bg);
      }

      th {
        padding: 13px 16px;
        text-align: left;
        font-family: "IBM Plex Mono", monospace;
        font-size: 10px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--text-muted);
        font-weight: 600;
        border-bottom: 1px solid var(--border);
      }

      td {
        padding: 14px 16px;
        font-size: 13.5px;
        color: var(--text);
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
      }

      tr:last-child td {
        border-bottom: none;
      }
      tr:hover td {
        background: var(--surface-hover);
      }

      .user-id {
        font-family: "IBM Plex Mono", monospace;
        font-size: 11px;
        color: var(--text-muted);
      }

      .role-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 100px;
        font-size: 11px;
        font-weight: 500;
        font-family: "IBM Plex Mono", monospace;
        text-transform: lowercase;
        background: var(--accent-soft);
        color: #e57373;
      }

      /* Action forms */
      .action-form {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      select {
        background: var(--bg);
        border: 1px solid var(--border);
        color: var(--text);
        padding: 6px 10px;
        border-radius: 6px;
        font-family: "IBM Plex Sans", sans-serif;
        font-size: 13px;
        cursor: pointer;
        outline: none;
        transition: border-color 0.15s;
      }

      select:focus {
        border-color: var(--update-text);
      }

      .btn {
        padding: 6px 13px;
        border-radius: 6px;
        border: none;
        font-family: "IBM Plex Sans", sans-serif;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        transition: opacity 0.15s;
        white-space: nowrap;
      }

      .btn:hover {
        opacity: 0.8;
      }

      .btn-update {
        background: var(--update);
        color: var(--update-text);
      }

      .btn-warn {
        background: var(--warn);
        color: var(--warn-text);
      }

      .btn-danger {
        background: rgba(192, 57, 43, 0.2);
        color: #ef5350;
      }

      /* Stats row */
      .stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
      }

      .stat-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 18px 20px;
      }

      .stat-label {
        font-family: "IBM Plex Mono", monospace;
        font-size: 10px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .stat-value {
        font-size: 28px;
        font-weight: 600;
        color: var(--text);
        margin-top: 6px;
        line-height: 1;
      }

      .stat-value span {
        font-size: 12px;
        font-weight: 400;
        color: var(--text-muted);
        margin-left: 4px;
      }

      /* ── MODAL ── */
      .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        z-index: 500;
        align-items: center;
        justify-content: center;
      }

      .modal-overlay.open {
        display: flex;
      }

      .modal {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 28px 32px;
        width: 420px;
        max-width: 90vw;
        animation: slideUp 0.2s ease;
      }

      @keyframes slideUp {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .modal h3 {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 8px;
      }

      .modal p {
        font-size: 13px;
        color: var(--text-muted);
        margin-bottom: 20px;
        line-height: 1.5;
      }

      .modal-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
      }

      .modal-actions .btn-cancel {
        background: var(--sidebar-bg);
        color: var(--text-muted);
        border: 1px solid var(--border);
      }

      .modal-form {
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin-bottom: 20px;
      }

      .modal-form label {
        font-size: 12px;
        color: var(--text-muted);
        font-family: "IBM Plex Mono", monospace;
        letter-spacing: 1px;
        text-transform: uppercase;
        display: block;
        margin-bottom: 5px;
      }

      .modal-form input,
      .modal-form select {
        width: 100%;
        background: var(--bg);
        border: 1px solid var(--border);
        color: var(--text);
        padding: 9px 12px;
        border-radius: 7px;
        font-family: "IBM Plex Sans", sans-serif;
        font-size: 13px;
      }

      .modal-form input:focus {
        outline: none;
        border-color: var(--update-text);
      }

      /* ── TOAST ── */
      .toast {
        position: fixed;
        bottom: 24px;
        right: 24px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 3px solid var(--accent);
        border-radius: 8px;
        padding: 12px 18px;
        font-size: 13px;
        color: var(--text);
        z-index: 999;
        transform: translateY(20px);
        opacity: 0;
        transition: all 0.25s ease;
        pointer-events: none;
      }

      .toast.show {
        opacity: 1;
        transform: translateY(0);
      }

      .toast.success {
        border-left-color: #2ecc71;
      }
      .toast.warning {
        border-left-color: var(--warn-text);
      }

      /* ── GENERIC PAGE ── */
      .generic-page {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 320px;
        gap: 12px;
      }

      .generic-page .page-icon {
        font-size: 48px;
        opacity: 0.3;
      }

      .generic-page h2 {
        font-size: 18px;
        font-weight: 600;
        color: var(--text-muted);
      }

      .generic-page p {
        font-size: 13px;
        color: var(--text-muted);
        opacity: 0.6;
      }
    </style>
  </head>
  <body>
    <!-- ── SIDEBAR ── -->
    <aside class="sidebar">
      <div class="sidebar-logo">
        <div class="logo-mark">MedSys</div>
        <div class="logo-name">Admin Console</div>
      </div>

      <div class="sidebar-section">
        <div class="sidebar-label">Overview</div>
        <button class="nav-item" onclick="navigate('dashboard')">
          <span class="nav-icon">⊞</span> Dashboard
        </button>
        <button class="nav-item active" onclick="navigate('users')">
          <span class="nav-icon">👤</span> Users
        </button>
        <button class="nav-item" onclick="navigate('roles')">
          <span class="nav-icon">🔑</span> Roles & Permissions
        </button>
      </div>

      <div class="sidebar-section">
        <div class="sidebar-label">Medical</div>
        <button class="nav-item" onclick="navigate('patients')">
          <span class="nav-icon">🏥</span> Patients
        </button>
        <button class="nav-item" onclick="navigate('appointments')">
          <span class="nav-icon">📅</span> Appointments
        </button>
        <button class="nav-item" onclick="navigate('records')">
          <span class="nav-icon">📋</span> Records
        </button>
        <button class="nav-item" onclick="navigate('departments')">
          <span class="nav-icon">🏢</span> Departments
        </button>
      </div>

      <div class="sidebar-section">
        <div class="sidebar-label">System</div>
        <button class="nav-item" onclick="navigate('audit')">
          <span class="nav-icon">📊</span> Audit Logs
        </button>
        <button class="nav-item" onclick="navigate('settings')">
          <span class="nav-icon">⚙️</span> Settings
        </button>
      </div>

      <div class="sidebar-footer">
        <div class="admin-badge">
          <div class="avatar">AD</div>
          <div class="admin-info">
            <div class="admin-name">Administrator</div>
            <div class="admin-role">super-admin</div>
          </div>
        </div>
      </div>
    </aside>

    <!-- ── MAIN ── -->
    <div class="main">
      <div class="topbar">
        <div>
          <div class="page-title" id="pageTitle">User Management</div>
          <div class="page-subtitle" id="pageSubtitle">
            manage · assign · delete
          </div>
        </div>
        <div class="topbar-actions">
          <button class="btn-add" id="addBtn" onclick="openAddModal()">
            + Add User
          </button>
        </div>
      </div>

      <div class="content">
        <!-- ── USERS PAGE ── -->
        <div class="page-view active" id="page-users">
          <div class="stats-row">
            <div class="stat-card">
              <div class="stat-label">Total Users</div>
              <div class="stat-value" id="statTotal">
                — <span>accounts</span>
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-label">Doctors</div>
              <div class="stat-value" id="statDoctors">—</div>
            </div>
            <div class="stat-card">
              <div class="stat-label">Nurses</div>
              <div class="stat-value" id="statNurses">—</div>
            </div>
            <div class="stat-card">
              <div class="stat-label">Admins</div>
              <div class="stat-value" id="statAdmins">—</div>
            </div>
          </div>

          <div class="table-card">
            <table>
              <thead>
                <tr>
                  <th>User ID</th>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Role</th>
                  <th>Update Role</th>
                  <th>Delete</th>
                  <th>Permanent Delete</th>
                </tr>
              </thead>
              <tbody id="userTableBody"></tbody>
            </table>
          </div>
        </div>

        <!-- ── GENERIC PAGES ── -->
        <div class="page-view" id="page-dashboard">
          <div class="generic-page">
            <div class="page-icon">⊞</div>
            <h2>Dashboard</h2>
            <p>Overview metrics and activity feed</p>
          </div>
        </div>
        <div class="page-view" id="page-roles">
          <div class="generic-page">
            <div class="page-icon">🔑</div>
            <h2>Roles & Permissions</h2>
            <p>Manage access control and role definitions</p>
          </div>
        </div>
        <div class="page-view" id="page-patients">
          <div class="generic-page">
            <div class="page-icon">🏥</div>
            <h2>Patients</h2>
            <p>View and manage patient records</p>
          </div>
        </div>
        <div class="page-view" id="page-appointments">
          <div class="generic-page">
            <div class="page-icon">📅</div>
            <h2>Appointments</h2>
            <p>Schedule and manage appointments</p>
          </div>
        </div>
        <div class="page-view" id="page-records">
          <div class="generic-page">
            <div class="page-icon">📋</div>
            <h2>Medical Records</h2>
            <p>Access and update patient medical records</p>
          </div>
        </div>
        <div class="page-view" id="page-departments">
          <div class="generic-page">
            <div class="page-icon">🏢</div>
            <h2>Departments</h2>
            <p>Manage hospital departments</p>
          </div>
        </div>
        <div class="page-view" id="page-audit">
          <div class="generic-page">
            <div class="page-icon">📊</div>
            <h2>Audit Logs</h2>
            <p>System activity and change history</p>
          </div>
        </div>
        <div class="page-view" id="page-settings">
          <div class="generic-page">
            <div class="page-icon">⚙️</div>
            <h2>Settings</h2>
            <p>System configuration and preferences</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ── ADD USER MODAL ── -->
    <div class="modal-overlay" id="addModal">
      <div class="modal">
        <h3>Add New User</h3>
        <p>Fill in the details to create a new system account.</p>
        <div class="modal-form">
          <div>
            <label>Full Name</label>
            <input
              type="text"
              id="newName"
              placeholder="e.g. Dr. Sarah Johnson"
            />
          </div>
          <div>
            <label>Email</label>
            <input
              type="email"
              id="newEmail"
              placeholder="email@hospital.org"
            />
          </div>
          <div>
            <label>Role</label>
            <select id="newRole">
              <option value="admin">Admin</option>
              <option value="doctor" selected>Doctor</option>
              <option value="nurse">Nurse</option>
              <option value="receptionist">Receptionist</option>
            </select>
          </div>
        </div>
        <div class="modal-actions">
          <button class="btn btn-cancel" onclick="closeModal('addModal')">
            Cancel
          </button>
          <button class="btn btn-add" onclick="addUser()">Create User</button>
        </div>
      </div>
    </div>

    <!-- ── CONFIRM MODAL ── -->
    <div class="modal-overlay" id="confirmModal">
      <div class="modal">
        <h3 id="confirmTitle">Confirm Action</h3>
        <p id="confirmMsg">Are you sure?</p>
        <div class="modal-actions">
          <button class="btn btn-cancel" onclick="closeModal('confirmModal')">
            Cancel
          </button>
          <button
            class="btn btn-danger"
            id="confirmOkBtn"
            onclick="executeConfirm()"
          >
            Confirm
          </button>
        </div>
      </div>
    </div>

    <!-- ── TOAST ── -->
    <div class="toast" id="toast"></div>

    <script>
  // ── DATA ──
  let users = [];

  // ── FETCH FROM API ──
  async function fetchUsers() {
    try {
      const response = await fetch("/api/users");
      const data = await response.json();

      users = data.map((user) => ({
        _id: user._id?.toString() || user._id,
        name: user.name,
        email: user.email,
        role: user.role,
      }));

      renderTable(); // Render after fetching
    } catch (err) {
      console.error("Failed to fetch users:", err);
      showToast("Failed to load users from server.", "warning");
    }
  }

  let pendingAction = null;
  let currentPage = "users";

  // ── NAVIGATION ──
  const pageConfig = {
    dashboard: {
      title: "Dashboard",
      subtitle: "overview · analytics · activity",
    },
    users: {
      title: "User Management",
      subtitle: "manage · assign · delete",
    },
    roles: {
      title: "Roles & Permissions",
      subtitle: "access · control · policies",
    },
    patients: { title: "Patients", subtitle: "records · history · care" },
    appointments: {
      title: "Appointments",
      subtitle: "schedule · manage · track",
    },
    records: {
      title: "Medical Records",
      subtitle: "documents · history · notes",
    },
    departments: {
      title: "Departments",
      subtitle: "units · staff · structure",
    },
    audit: { title: "Audit Logs", subtitle: "events · changes · history" },
    settings: {
      title: "Settings",
      subtitle: "configure · customize · manage",
    },
  };

  function navigate(page) {
    document
      .querySelectorAll(".page-view")
      .forEach((p) => p.classList.remove("active"));
    document
      .querySelectorAll(".nav-item")
      .forEach((n) => n.classList.remove("active"));

    document.getElementById("page-" + page).classList.add("active");

    document.querySelectorAll(".nav-item").forEach((item) => {
      if (item.getAttribute("onclick") === `navigate('${page}')`) {
        item.classList.add("active");
      }
    });

    const cfg = pageConfig[page];
    document.getElementById("pageTitle").textContent = cfg.title;
    document.getElementById("pageSubtitle").textContent = cfg.subtitle;

    document.getElementById("addBtn").style.display =
      page === "users" ? "" : "none";

    currentPage = page;
  }

  // ── RENDER TABLE ──
  function renderTable() {
    const tbody = document.getElementById("userTableBody");
    tbody.innerHTML = "";

    users.forEach((user) => {
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td><span class="user-id">${user._id}</span></td>
        <td>${user.name}</td>
        <td>${user.email}</td>
        <td><span class="role-badge">${user.role}</span></td>
        <td>
          <div class="action-form">
            <select id="sel-${user._id}">
              <option value="admin" ${user.role === "admin" ? "selected" : ""}>Admin</option>
              <option value="doctor" ${user.role === "doctor" ? "selected" : ""}>Doctor</option>
              <option value="nurse" ${user.role === "nurse" ? "selected" : ""}>Nurse</option>
              <option value="receptionist" ${user.role === "receptionist" ? "selected" : ""}>Receptionist</option>
              <option value="pharmacy" ${user.role === "pharmacy" ? "selected" : ""}>Pharmacy</option>
            </select>
            <button class="btn btn-update" onclick="updateRole('${user._id}')">Update</button>
          </div>
        </td>
        <td>
          <button class="btn btn-warn" onclick="softDelete('${user._id}')">Delete</button>
        </td>
        <td>
          <button class="btn btn-danger" onclick="permanentDelete('${user._id}')">Permanent</button>
        </td>
      `;
      tbody.appendChild(tr);
    });

    updateStats();
  }

  // ── STATS ──
  function updateStats() {
    document.getElementById("statTotal").innerHTML = `${users.length} <span>accounts</span>`;
    document.getElementById("statDoctors").textContent = users.filter((u) => u.role === "doctor").length;
    document.getElementById("statNurses").textContent = users.filter((u) => u.role === "nurse").length;
    document.getElementById("statAdmins").textContent = users.filter((u) => u.role === "admin").length;
  }

  // ── UPDATE ROLE ──
  function updateRole(id) {
    const newRole = document.getElementById("sel-" + id).value;
    const user = users.find((u) => u._id === id);
    if (!user) return;
    if (user.role === newRole) {
      showToast("No change made.", "");
      return;
    }

    pendingAction = () => {
      user.role = newRole;
      renderTable();
      showToast(`Role updated to "${newRole}" for ${user.name}`, "success");
    };

    showConfirm(
      "Update Role",
      `Change ${user.name}'s role to <strong>${newRole}</strong>?`,
      "Update"
    );
  }

  // ── SOFT DELETE ──
  function softDelete(id) {
    const user = users.find((u) => u._id === id);
    if (!user) return;

    pendingAction = () => {
      users = users.filter((u) => u._id !== id);
      renderTable();
      showToast(`${user.name} has been deactivated.`, "warning");
    };

    showConfirm(
      "Delete User",
      `Are you sure you want to delete <strong>${user.name}</strong>?`,
      "Delete"
    );
  }

  // ── PERMANENT DELETE ──
  function permanentDelete(id) {
    const user = users.find((u) => u._id === id);
    if (!user) return;

    pendingAction = () => {
      users = users.filter((u) => u._id !== id);
      renderTable();
      showToast(`${user.name} permanently deleted.`, "");
    };

    document.getElementById("confirmOkBtn").className = "btn btn-danger";
    showConfirm(
      "⚠️ Permanent Delete",
      `This will <strong>permanently</strong> remove ${user.name}'s account and all associated data. This cannot be undone.`,
      "Delete Permanently"
    );
  }

  // ── ADD USER ──
  function openAddModal() {
    document.getElementById("newName").value = "";
    document.getElementById("newEmail").value = "";
    document.getElementById("newRole").value = "doctor";
    document.getElementById("addModal").classList.add("open");
  }

  function addUser() {
    const name = document.getElementById("newName").value.trim();
    const email = document.getElementById("newEmail").value.trim();
    const role = document.getElementById("newRole").value;

    if (!name || !email) {
      showToast("Please fill in all fields.", "");
      return;
    }

    const newId = "USR-" + String(users.length + 1).padStart(3, "0");
    users.push({ _id: newId, name, email, role });
    renderTable();
    closeModal("addModal");
    showToast(`${name} added successfully.`, "success");
  }

  // ── CONFIRM MODAL ──
  function showConfirm(title, msg, okLabel) {
    document.getElementById("confirmTitle").textContent = title;
    document.getElementById("confirmMsg").innerHTML = msg;
    document.getElementById("confirmOkBtn").textContent = okLabel;
    document.getElementById("confirmModal").classList.add("open");
  }

  function executeConfirm() {
    closeModal("confirmModal");
    if (pendingAction) {
      pendingAction();
      pendingAction = null;
    }
    document.getElementById("confirmOkBtn").className = "btn btn-danger";
  }

  // ── MODAL HELPERS ──
  function closeModal(id) {
    document.getElementById(id).classList.remove("open");
  }

  // Close modal on overlay click
  document.querySelectorAll(".modal-overlay").forEach((overlay) => {
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) overlay.classList.remove("open");
    });
  });

  // ── TOAST ──
  function showToast(msg, type) {
    const t = document.getElementById("toast");
    t.textContent = msg;
    t.className = "toast " + (type || "");
    setTimeout(() => t.classList.add("show"), 10);
    setTimeout(() => t.classList.remove("show"), 3200);
  }

  // ── INIT - FETCH USERS ON PAGE LOAD ──
  fetchUsers();
</script>  </body>
</html>
