<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Doctor Panel - Patients</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 20px;
    }
    h2 {
      text-align: center;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }
    th, td {
      border: 1px solid #ddd;
      padding: 10px;
      text-align: left;
    }
    th {
      background-color: #1976d2;
      color: white;
    }
    tr:nth-child(even) {
      background-color: #f5f5f5;
    }
  </style>
</head>
<body>

  <h2>Doctor Panel – Patient Records</h2>

  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Patient Name</th>
        <th>Age</th>
        <th>Gender</th>
        <th>Disease</th>
        <th>Admitted Date</th>
      </tr>
    </thead>

    <tbody>
      <% if (patients.length === 0) { %>
        <tr>
          <td colspan="6" style="text-align:center;">
            No patients found
          </td>
        </tr>
      <% } %>

      <% patients.forEach((patient, index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= patient.name %></td>
          <td><%= patient.age %></td>
          <td><%= patient.gender %></td>
          <td><%= patient.disease %></td>
          <td><%= patient.createdAt.toDateString() %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

</body>
</html>
