<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Nurse Panel - Patients</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 20px;
      background-color: rgb(165, 165, 176);
    }
    h2 {
      text-align: center;
    }
    ul {
      list-style: none;
      padding: 0;
      max-width: 400px;
      margin: 30px auto;
    }
    li {
      background: #f6f3f3;
      padding: 10px;
      margin-bottom: 8px;
      border-radius: 5px;
    }
  </style>
</head>
<body>

  <h2>Nurse Panel – Patient Names</h2>

  <ul>
    <% if (patients.length === 0) { %>
      <li>No patients found</li>
    <% } %>

    <% patients.forEach(patient => { %>
      <li><%= patient.name %></li>
    <% }) %>
  </ul>

</body>
</html>
